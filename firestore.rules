rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isWorkspaceMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/workspaces/techgajana/members/$(request.auth.uid));
    }

    match /workspaces/techgajana/members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /workspaces/techgajana/drafts/{uid} {
      allow read, write: if isWorkspaceMember() && request.auth.uid == uid;
    }

    match /workspaces/techgajana/invoices/{invoiceId} {
      allow read, write: if isWorkspaceMember();
    }

    match /workspaces/techgajana/clients/{clientId} {
      allow read, write: if isWorkspaceMember();
    }
  }
}