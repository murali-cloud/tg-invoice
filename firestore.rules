rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/techgajana/drafts/{draftId} {
      allow read, write: if true;
    }

    match /workspaces/techgajana/invoice/{invoiceId} {
      allow read, delete: if true;
    }

    match /workspaces/techgajana/invoices/{invoiceId} {
      allow read, write: if true;
    }

    match /workspaces/techgajana/clients/{clientId} {
      allow read, write: if true;
    }

    match /workspaces/techgajana/counters/{counterId} {
      allow read, write: if true;
    }
  }
}